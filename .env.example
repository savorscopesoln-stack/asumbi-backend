# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

PORT=5000

# ---- Database (SQL Server) ----
# Local dev (SQL Server Express on your machine):
#   DB_SERVER=localhost\SQLEXPRESS   (or your instance name)
#   DB_ENCRYPT=false
#
# Cloud (Azure SQL Database):
#   DB_SERVER=your-server-name.database.windows.net
#   DB_ENCRYPT=true
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=asumbi_campus
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ---- DB connection pool (tune based on load testing, see PERFORMANCE.md) ----
# DB_POOL_MAX: physical SQL connections in the shared pool. 50 is a
# conservative default for exam-login's 2 lightweight indexed queries.
# Raise only after confirming SQL Server has CPU/connection headroom.
DB_POOL_MAX=50
DB_POOL_MIN=2
DB_POOL_IDLE_MS=30000
# How long a request will wait for a free pool connection before failing
# fast with a 503 (instead of hanging on tarn's 30s default).
DB_POOL_ACQUIRE_TIMEOUT_MS=8000

# ---- Multiple databases from ONE backend process ----
# Leave DB_TENANTS empty for a normal single-database deployment — the
# DB_* vars above are all that's used, exactly as before.
#
# To let this same backend serve a second database (e.g. a second
# school/campus), add its short key here and give it its own
# DB_*_<KEY> vars (KEY uppercased, e.g. "eregi" -> DB_USER_EREGI):
#
#   DB_TENANTS=eregi
#   DB_USER_EREGI=
#   DB_PASSWORD_EREGI=
#   DB_SERVER_EREGI=
#   DB_NAME_EREGI=eregi
#   (DB_PORT_EREGI / DB_ENCRYPT_EREGI / DB_TRUST_CERT_EREGI are optional
#   per-tenant overrides; anything not set falls back to the shared
#   DB_PORT/DB_ENCRYPT/DB_TRUST_CERT above. Pool sizing/timeouts above
#   are always shared across every tenant.)
#
# Then tell the server how to recognize which tenant a request belongs
# to — set ONE (or more) of these three maps, "value:tenantKey" pairs,
# comma-separated. Checked in this order, first match wins:
#   DB_TENANT_HEADER_MAP  — an X-Db-Tenant header the frontend sends
#   DB_TENANT_ORIGIN_MAP  — the frontend's own Origin (no frontend change needed)
#   DB_TENANT_HOST_MAP    — the Host this API itself was reached on
#
# Example: eregi's frontend is a separate deployment at its own URL —
# map its Origin straight to the "eregi" tenant, no frontend change:
#   DB_TENANT_ORIGIN_MAP=https://eregi-portal.vercel.app:eregi
# Remember that origin ALSO needs to be in FRONTEND_URL/WEBSITE_URL
# below, or CORS will block it before tenant resolution even runs.
DB_TENANTS=
# DB_TENANT_HEADER_MAP=
# DB_TENANT_ORIGIN_MAP=
# DB_TENANT_HOST_MAP=

# ---- Auth ----
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call this API.
# Include both your deployed frontend and localhost while testing.
# FRONTEND_URL is the admin portal (Vite/React app, port 5173 in dev).
FRONTEND_URL=http://localhost:5173

# WEBSITE_URL is the SEPARATE public marketing site (Next.js, port 3000
# in dev). Its Contact form and newsletter signup POST to this API
# directly from the visitor's browser (see routes/contact.js), so its
# origin must be allowed here too, or the browser blocks the response
# even though the request itself reaches the server fine.
WEBSITE_URL=http://localhost:3000

NODE_ENV=development

# ---- Admin > Notifications broadcast page ----
# All of these are optional — a channel is simply skipped (and logged
# as "skipped" in that notification's result summary) if its env vars
# aren't set, so in-app notifications always work even before email/
# SMS/WhatsApp are configured.

# Email (any standard SMTP provider — Gmail, SendGrid SMTP, Mailgun SMTP, etc.)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# SMS + WhatsApp (via Twilio's REST API)
# TWILIO_SMS_FROM is a Twilio phone number, e.g. +15551234567
# TWILIO_WHATSAPP_FROM is your Twilio WhatsApp sender, e.g. +14155238886
# (the sandbox number while testing, or your approved WhatsApp Business
# number in production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
