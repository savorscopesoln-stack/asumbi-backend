# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

PORT=5000

# ---- Database (SQL Server) ----
# Local dev (SQL Server Express on your machine):
#   DB_SERVER=localhost\SQLEXPRESS   (or your instance name)
#   DB_ENCRYPT=false
#
# Cloud (Azure SQL Database):
#   DB_SERVER=your-server-name.database.windows.net
#   DB_ENCRYPT=true
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=asumbi_campus
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ---- Auth ----
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call this API.
# Include both your deployed frontend and localhost while testing.
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
