# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

PORT=5000

# ---- Database (SQL Server) ----
# Local dev (SQL Server Express on your machine):
#   DB_SERVER=localhost\SQLEXPRESS   (or your instance name)
#   DB_ENCRYPT=false
#
# Cloud (Azure SQL Database):
#   DB_SERVER=your-server-name.database.windows.net
#   DB_ENCRYPT=true
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=asumbi_campus
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ---- Multi-tenant (optional) ----
# List extra tenant keys here (comma-separated) to check MORE than one
# database during login — e.g. a second school hosted on its own DB.
# For each key, add DB_<VAR>_<KEY> overrides (falls back to the plain
# DB_<VAR> above for anything you don't override). Example for
# DB_TENANTS=eregi:
#   DB_SERVER_EREGI=...
#   DB_NAME_EREGI=eregi
#   DB_USER_EREGI=...
#   DB_PASSWORD_EREGI=...
#   DB_PORT_EREGI=1433
#   DB_ENCRYPT_EREGI=true
#   DB_TRUST_CERT_EREGI=false
DB_TENANTS=

# ---- DB connection pool (tune based on load testing, see PERFORMANCE.md) ----
# DB_POOL_MAX: physical SQL connections in the shared pool. 50 is a
# conservative default for exam-login's 2 lightweight indexed queries.
# Raise only after confirming SQL Server has CPU/connection headroom.
DB_POOL_MAX=50
DB_POOL_MIN=2
DB_POOL_IDLE_MS=30000
# How long a request will wait for a free pool connection before failing
# fast with a 503 (instead of hanging on tarn's 30s default).
DB_POOL_ACQUIRE_TIMEOUT_MS=8000

# ---- Auth ----
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call this API.
# Include both your deployed frontend and localhost while testing.
# FRONTEND_URL is the admin portal (Vite/React app, port 5173 in dev).
FRONTEND_URL=http://localhost:5173

# WEBSITE_URL is the SEPARATE public marketing site (Next.js, port 3000
# in dev). Its Contact form and newsletter signup POST to this API
# directly from the visitor's browser (see routes/contact.js), so its
# origin must be allowed here too, or the browser blocks the response
# even though the request itself reaches the server fine.
WEBSITE_URL=http://localhost:3000

NODE_ENV=development

# ---- Admin > Notifications broadcast page ----
# All of these are optional — a channel is simply skipped (and logged
# as "skipped" in that notification's result summary) if its env vars
# aren't set, so in-app notifications always work even before email/
# SMS/WhatsApp are configured.

# Email (any standard SMTP provider — Gmail, SendGrid SMTP, Mailgun SMTP, etc.)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# SMS + WhatsApp (via Twilio's REST API)
# TWILIO_SMS_FROM is a Twilio phone number, e.g. +15551234567
# TWILIO_WHATSAPP_FROM is your Twilio WhatsApp sender, e.g. +14155238886
# (the sandbox number while testing, or your approved WhatsApp Business
# number in production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---- Doravo Finance contact (institution wallet credit requests) ----
# Shown on the institution admin's Examination Wallet page as "Request
# Credits via Email/WhatsApp" — these are Doravo's OWN contact details
# (not the institution's), prefilled into a mailto:/wa.me link the
# admin's browser opens directly. Nothing is sent server-side and no
# credit request is ever recorded — verifying the actual payment and
# depositing credits is still a manual step by Doravo Finance in the
# finance dashboard (see routes/finance.js). Either button is disabled
# with a clear message on the wallet page if its var isn't set — see
# utils/creditRequestMessage.js.
# DORAVO_FINANCE_WHATSAPP is in wa.me's expected format: digits only,
# country code, no "+", no spaces, e.g. 254712345678
DORAVO_FINANCE_EMAIL=
DORAVO_FINANCE_WHATSAPP=

# ---- AI-assisted marking (v2.1) — everything is OFF unless set to "true" ----
# AI_MARKING_JOBS_ENABLED=false
# AI_MARKING_WORKER_ENABLED=false
# AI_MARKING_PROVIDER=anthropic        # "mock" is refused in production
# AI_MARKING_API_KEY=
# AI_MARKING_MODEL=
# AI_MARKING_BASE_URL=
# AI_MARKING_ALLOWED_HOSTS=
# AI_MARKING_COST_INPUT_PER_MTOK=
# AI_MARKING_COST_OUTPUT_PER_MTOK=
# AI_MARKING_COST_CURRENCY=USD
# AI_MARKING_SCHEME_SUGGESTIONS=off
# AI_MARKING_MAX_TOPUP=5000000
# AI_MARKING_MAX_PRICE_PER_ANSWER=10000
# See docs/ai_marking/PHASE5/6/11 notes for the full list (rate limits, concurrency, retries).
